{
  "name": "your-bot", "version": "0.1.0", "private": true, "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "dev": "npm run dev -w @your-bot/desktop",
    "start": "npm run start -w @your-bot/desktop",
    "package": "npm run package -w @your-bot/desktop"
  },
  "devDependencies": {"typescript": "~5.9.3", "vitest": "^4.0.18", "@types/node": "^22.19.0"}
}
