{
  "name": "your-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build -w @your-bot/contracts && npm run build -w @your-bot/core && npm run build -w @your-bot/adapters && npm run build -w @your-bot/executor && npm run build -w @your-bot/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "dev": "npm run dev -w @your-bot/desktop",
    "start": "npm run start -w @your-bot/desktop",
    "package": "npm run package -w @your-bot/desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
